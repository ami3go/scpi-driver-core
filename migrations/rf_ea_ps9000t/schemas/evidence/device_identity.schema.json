{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rfds.local/schemas/rf_ea_ps9000t/device_identity.schema.json",
  "title": "rfds.device_identity",
  "description": "device_identity.json — recorded once Connect attaches an EA-PS 9000 T session for a given alias.",
  "type": "object",
  "required": ["schema", "schema_version", "run_id", "timestamp_utc"],
  "properties": {
    "schema": {"const": "rfds.device_identity"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "run_id": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "manufacturer": {"type": "string"},
    "device_family": {"type": "string"},
    "resource": {"type": "string"},
    "transport_type": {"type": "string"},
    "identity_raw": {"type": ["string", "null"]},
    "simulated": {"type": "boolean"}
  },
  "additionalProperties": true
}
