{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rfds.local/schemas/rf_ngi_n83624/operation.schema.json",
  "title": "rfds.operation",
  "description": "One line of events/operations.jsonl: one public keyword invocation, written by EvidenceRun.record_operation().",
  "type": "object",
  "required": [
    "schema", "schema_version", "run_id", "operation_id", "correlation_id",
    "capability", "arguments", "start_timestamp_utc", "end_timestamp_utc",
    "duration_s", "status", "sequence"
  ],
  "properties": {
    "schema": {"const": "rfds.operation"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "run_id": {"type": "string"},
    "operation_id": {"type": "string", "pattern": "^op-"},
    "correlation_id": {"type": "string", "pattern": "^corr-"},
    "capability": {"type": "string"},
    "session_alias": {"type": ["string", "null"]},
    "arguments": {"type": "object"},
    "start_timestamp_utc": {"type": "string", "format": "date-time"},
    "end_timestamp_utc": {"type": "string", "format": "date-time"},
    "duration_s": {"type": "number", "minimum": 0},
    "result": {},
    "status": {"enum": ["PASS", "FAIL"]},
    "error_summary": {"type": ["string", "null"]},
    "sequence": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
