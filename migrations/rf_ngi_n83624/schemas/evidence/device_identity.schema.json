{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rfds.local/schemas/rf_ngi_n83624/device_identity.schema.json",
  "title": "rfds.device_identity",
  "description": "device_identity.json — recorded once an N83624 connection alias completes Connect (or fails identity verification).",
  "type": "object",
  "required": ["schema", "schema_version", "run_id", "timestamp_utc"],
  "properties": {
    "schema": {"const": "rfds.device_identity"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "run_id": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "manufacturer": {"type": "string"},
    "model": {"type": "string"},
    "identity_response": {"type": ["string", "null"]},
    "transport_type": {"type": "string"},
    "resource": {"type": "string"}
  },
  "additionalProperties": true
}
