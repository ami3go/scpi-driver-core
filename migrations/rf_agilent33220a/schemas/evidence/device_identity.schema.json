{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rfds.local/schemas/rf_agilent33220a/device_identity.schema.json",
  "title": "rfds.device_identity",
  "description": "device_identity.json — one entry per connected alias, since this driver supports multiple simultaneous named generator connections (the `alias` argument accepted by every non-connection keyword).",
  "type": "object",
  "required": ["schema", "schema_version", "run_id", "timestamp_utc", "connections"],
  "properties": {
    "schema": {"const": "rfds.device_identity"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "run_id": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "connections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "resource": {"type": ["string", "null"]},
          "transport_type": {"type": "string"},
          "identity": {"type": ["string", "null"]},
          "simulated": {"type": "boolean"}
        }
      }
    }
  },
  "additionalProperties": false
}
